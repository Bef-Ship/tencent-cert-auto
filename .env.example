# Docker 构建基础镜像 / 架构（可选，compose build 时读取）
GO_IMAGE=golang:1.26-alpine
RUNTIME_IMAGE=alpine:3.19
DOCKER_PLATFORM=linux/amd64

# DNSPod 解析密钥（仅域名解析读写）
DP_ID=xxxx
DP_KEY=xxxx

# 腾讯云 CAM（deploy.yml 含 tencent_ssl / cdn / clb / apigateway 时需要）
# 最小权限：
#   ssl:UploadCertificate
#   ssl:DeployCertificateInstance   # type: cdn / clb
#   apigateway:ModifySubDomain
TENCENT_SECRET_ID=xxxx
TENCENT_SECRET_KEY=xxxx
TENCENT_REGION=ap-shanghai

# 消息推送 Webhook（可留空关闭；支持企微 / Slack / Lark）
# NOTIFY_PROVIDER: auto|wecom|slack|lark（默认 auto，按 URL 自动识别）
NOTIFY_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxx
NOTIFY_PROVIDER=auto

# 证书配置
CERT_DOMAIN=*.example.com
LEGO_EMAIL=ops@example.com
CERT_DIR=/app/cert-data

# 统一部署目标（tencent_ssl / cdn / clb / apigateway / local / ssh），见 deploy.example.yml
DEPLOY_TARGETS_FILE=/app/deploy.yml

RENEW_DAYS=30
CHECK_INTERVAL=24h

LOG_LEVEL=info
LOG_FORMAT=text
